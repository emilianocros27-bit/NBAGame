rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso del juego: solo tu propia cuenta
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      // El dueño escribe libre su propio save. El comisionado (vía Claude en el chat) puede
      // otorgar insignias manualmente a cualquiera vía updateDoc con dot-path ("state.badge90s"),
      // lo que Firestore reporta como cambio al campo raíz "state" (no hay granularidad más fina).
      allow update: if request.auth != null &&
        (request.auth.uid == uid ||
         (request.auth.token.email == "emilianocros27@gmail.com" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state"])));
    }

    // Perfiles: cualquiera autenticado puede VER, solo el dueño edita
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // @usuarios: cualquiera autenticado puede buscar (leer).
    // Crear: solo si reclamas tu propio uid. No se puede pisar el de otro.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Amistades: solo los dos implicados pueden leer/escribir
    match /friendships/{pair} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Intercambios: solo los implicados (campo parties = [from, to])
    match /trades/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.parties;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.parties;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.parties;
    }

    // Clasificación del minijuego: tabla pública; cada quien escribe solo su récord.
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Fantasy: temporada compartida (mapa equipo->dueño), calendario por equipo y partidos.
    // Todo autenticado puede leer/reclamar equipo (escribe "teams"), mover jugadores al ejecutar
    // un trade ya aceptado, y acreditar el dinero de ese trade (playerMoves/budgetBonus) — el propio
    // código de la app solo dispara esos cambios al firmar una oferta, no hay botón libre para tocarlos.
    // Solo el comisionado puede arrancar/reiniciar el reloj de temporada (started/startedAt/endsAt).
    // Con "locked" (DT cerrado), nadie más puede tocar la temporada, ni reclamar equipo, hasta que el comisionado la abra.
    match /fantasySeason/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.token.email == "emilianocros27@gmail.com"
         || (request.resource.data.started == resource.data.started
             && resource.data.get("locked", false) == false
             && request.resource.data.get("locked", false) == false));
    }
    match /fantasySchedules/{team} {
      allow read, write: if request.auth != null;
    }
    match /fantasyGames/{id} {
      allow read, write: if request.auth != null;
    }
    match /fantasyLineups/{team} {
      allow read, write: if request.auth != null;
    }
    // Ofertas de mercado: cualquiera autenticado crea la suya. Solo el comisionado puede
    // ejecutar (mover jugadores) tras una aceptación, vía Claude en el chat.
    // Excepciones:
    //  - el dueño del equipo que RECIBE una oferta pendiente puede FIRMARLA tal cual (-> accepted),
    //    RECHAZARLA directo (-> rejected), o MODIFICARLA (-> countered), que de nuevo solo el
    //    comisionado resuelve;
    //  - quien la ENVIÓ puede CANCELARLA mientras siga pendiente o contraofertada (-> cancelled),
    //    o FIRMAR la contraoferta que le devolvieron (countered -> accepted).
    match /fantasyTrades/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
        (request.auth.token.email == "emilianocros27@gmail.com"
         || (resource.data.status == "pending"
             && get(/databases/$(database)/documents/fantasySeason/current).data.teams[resource.data.toTeam] == request.auth.uid
             && (
                  (request.resource.data.status == "countered"
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["offeredSlug","amount","status","originalOfferedSlug","originalAmount"]))
                  ||
                  (request.resource.data.status == "accepted"
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
                  ||
                  (request.resource.data.status == "rejected"
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
                ))
         || (request.auth.uid == resource.data.fromUid
             && (resource.data.status == "pending" || resource.data.status == "countered")
             && request.resource.data.status == "cancelled"
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
         // quien mandó la oferta puede FIRMAR la contraoferta que le devolvieron
         || (request.auth.uid == resource.data.fromUid
             && resource.data.status == "countered"
             && request.resource.data.status == "accepted"
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])));
      // borrar: solo el comisionado, al reiniciar DT
      allow delete: if request.auth != null && request.auth.token.email == "emilianocros27@gmail.com";
    }
    // Buzón privado de avisos de Fantasy (ej. "se aceptó tu oferta"): el comisionado los crea,
    // cada quien solo puede leer/marcar-leído los suyos.
    match /fantasyInbox/{id} {
      allow read: if request.auth != null &&
        (resource.data.toUid == request.auth.uid || request.auth.token.email == "emilianocros27@gmail.com");
      allow create: if request.auth != null && request.auth.token.email == "emilianocros27@gmail.com";
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid
                    && request.resource.data.toUid == resource.data.toUid;
      // borrar: solo el comisionado, al reiniciar DT
      allow delete: if request.auth != null && request.auth.token.email == "emilianocros27@gmail.com";
    }
    // Noticias de la temporada: cualquiera autenticado puede leer; publicarlas las hace el comisionado
    // (el dueño de la cuenta, vía Claude) — no hay UI de redactar dentro del juego.
    match /fantasyNews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Códigos de un solo uso: cualquiera autenticado los genera/lee;
    // reclamar = pasar used de false a true (una sola vez).
    match /codes/{code} {
      allow get, create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.used == false
                    && request.resource.data.used == true;
      allow delete: if false;
    }
  }
}
